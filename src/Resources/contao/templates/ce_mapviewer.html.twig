<div class="{{class}}">

    {% if Map.title %}
        <h1>{{ Map.title }}</h1>
    {% endif %}
    {% if Map.description %}
        {{ Map.description|raw }}
    {% endif %}

    <div id="cmap_{{id}}" style="width:100%;height: {{Map.height}}"></div>
    
</div>


<script type="text/javascript">
	var points_{{id}} = {{ Points|json_encode()|raw}};
	var map_{{id}};
	var default_zoom_{{id}} = {{ Map.zoom|default(0) }};
	var default_pos_{{id}} = [{{Map.latitude|default(0) }}, {{Map.longitude|default(0)}}];
	var min_zoom_{{id}} = {{ Map.minzoom|default(0) }};
	var max_zoom_{{id}} = {{ Map.maxzoom|default(0) }};
    var markers_{{id}} = [];
    
    var LeafIcon = L.Icon.extend({});	
    
    function PopupHide_{{id}}(){
        {% if Map.autozoom  %}
            var group = new L.featureGroup(markers_{{id}});
            map_{{id}}.fitBounds(group.getBounds());
        {% else %}
            map_{{id}}.flyTo(default_pos_{{id}},default_zoom_{{id}});
        {% endif %}
	};
	
    function MarkerClick_{{id}}(e)
    {
      map_{{id}}.flyTo(e.latlng,e.target.options.zoom);
    };    


    document.addEventListener('DOMContentLoaded', function () {
        
        map_{{id}} = L.map('cmap_{{id}}').setView(default_pos_{{id}}, default_zoom_{{id}});
    
       {% if not Map.mousescroll  %}
            map_{{id}}.scrollWheelZoom.disable();
       {% endif %}

        L.tileLayer('{{ Map.titleURL }}', {
            maxZoom: max_zoom_{{id}},
            minZoom: min_zoom_{{id}},
            attribution: '{{ Map.copyright }}'
        }).addTo(map_{{id}});
        
        
	    //map_{{id}}.attributionControl.setPrefix('{{ Map.copyright }}');

	    points_{{id}}.forEach(function(value, index) {

            if (value.image){

                    var cicon = new LeafIcon({
                                    iconUrl: value.image ,
                                    iconSize: [value.size[0], value.size[1]],
                                    iconAnchor: [value.size[0]/2, value.size[1]/2],
                                    popupAnchor:  [0, value.size[1]/3 * -1 ]
                                });

                    if( value.info == true){
                        markers_{{id}}.push(L.marker([value.latitude, value.longitude], {zoom: value.zoom, icon: cicon }).on('click', MarkerClick_{{id}}).bindPopup(value.description).addTo(map_{{id}}))
                    }else{
                        markers_{{id}}.push(L.marker([value.latitude, value.longitude], {icon: cicon}).addTo(map_{{id}}))
                    }

            }else{

                if( value.info == true){
                    markers_{{id}}.push(L.marker([value.latitude, value.longitude], {zoom: value.zoom}).on('click', MarkerClick_{{id}}).bindPopup(value.description).addTo(map_{{id}}))
                }else{
                    markers_{{id}}.push(L.marker([value.latitude, value.longitude]).addTo(map_{{id}}))
                }

            }

        });

	    {% if Map.autozoom %}
            var group_{{id}} = new L.featureGroup(markers_{{id}});
            map_{{id}}.fitBounds(group_{{id}}.getBounds());
        {% else %}
            map_{{id}}.flyTo(default_pos_{{id}},default_zoom_{{id}});
        {% endif %}

        map_{{id}}.on('popupclose',PopupHide_{{id}});

    });

</script>
